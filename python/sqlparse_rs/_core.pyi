from typing import Any, Callable

UNIDATA_VERSION: str

class Core:
    def __init__(self, types: list[Any], flags: list[int], keywords: list[tuple[str, int]], is_keyword: Callable[[str], Any]) -> None: ...
    def tokenize(self, text: str) -> list[tuple[Any, str]]: ...
    def split(self, text: str, strip_semicolon: bool) -> list[str] | None: ...
    def split_many(self, texts: list[str], strip_semicolon: bool) -> list[list[str] | None]: ...
